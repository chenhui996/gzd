{
  "name": "gz-ui-common",
  "private": false,
  "version": "0.2.3-beta.4",
  "type": "module",
  "files": [
    "gzd-lib"
  ],
  "main": "./gzd-lib/index.cjs",
  "module": "./gzd-lib/index.js",
  "types": "./gzd-lib/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "exports": {
    ".": {
      "types": "./gzd-lib/index.d.ts",
      "import": "./gzd-lib/index.js",
      "require": "./gzd-lib/index.cjs"
    },
    "./gzd-table": {
      "types": "./gzd-lib/gzd-table/index.d.ts",
      "import": "./gzd-lib/gzd-table/index.js",
      "require": "./gzd-lib/gzd-table/index.cjs"
    },
    "./business-components/pcs": {
      "types": "./gzd-lib/business-components/pcs/index.d.ts",
      "import": "./gzd-lib/business-components/pcs/index.js",
      "require": "./gzd-lib/business-components/pcs/index.cjs"
    },
    "./gzd.css": "./gzd-lib/gzd.css",
    "./style.css": "./gzd-lib/gzd.css"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "verify:exports": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler scripts/fixtures/gzd-consumer.ts scripts/fixtures/gzd-table-consumer.ts scripts/fixtures/pcs-business-components-consumer.ts && node scripts/verify-package-exports.js",
    "test:ct": "playwright install chromium && playwright test -c playwright-ct.config.ts",
    "prepack": "npm run docs:sync && npm run build && npm run verify:exports && npm run predev",
    "lint": "eslint .",
    "test": "vitest run && npm run test:release",
    "test:release": "node --test scripts/release-prepare.test.js",
    "preview": "vite preview",
    "predev": "npm run docs:sync && npm run docs:tokens",
    "dev": "dumi dev",
    "devw": "father dev",
    "predocs:build": "npm run docs:sync && npm run docs:tokens:check",
    "docs:build": "dumi build",
    "docs:sync": "node scripts/syncChangelog.js",
    "docs:tokens": "node scripts/generateTokenDocs.js",
    "docs:tokens:check": "node scripts/generateTokenDocs.js --check",
    "release:prepare": "node scripts/release-prepare.js",
    "tokens:import": "node scripts/importTokens.js",
    "tokens:transform": "node scripts/transformAllTokens.js && node scripts/transformAgGridTokens.js && npm run docs:tokens",
    "tokens:transform:ag-grid": "node scripts/transformAgGridTokens.js && npm run docs:tokens"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.0.0",
    "@ant-design/happy-work-theme": "^2.0.0",
    "antd-img-crop": "^4.30.0",
    "antd-style": "^4.1.0",
    "big.js": "7.0.1",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.20",
    "echarts": "6.1.0",
    "lunar-typescript": "^1.8.6",
    "rc-tween-one": "^3.0.6",
    "react-router": "^7.13.1",
    "react-sticky-box": "^2.0.5"
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.1",
    "@ant-design/happy-work-theme": "^2.0.0",
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.1",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@rc-component/tabs": "^1.11.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/big.js": "^7.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ag-grid-community": "36.0.1",
    "ag-grid-enterprise": "36.0.1",
    "ag-grid-react": "36.0.1",
    "antd": "^6.5.1",
    "antd-img-crop": "^4.30.0",
    "antd-style": "^4.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "dumi": "^2.4.21",
    "dumi-theme-antd-style": "^0.31.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "father": "^4.6.23",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "lunar-typescript": "^1.8.6",
    "rc-tween-one": "^3.0.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-draggable": "^4.5.0",
    "react-fast-marquee": "^1.6.5",
    "react-layout-kit": "^1.9.2",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "react-sticky-box": "^2.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "ag-grid-community": "36.0.1",
    "ag-grid-enterprise": "36.0.1",
    "ag-grid-react": "36.0.1",
    "antd": "6.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
